#!/usr/bin/env bash

set -e

[[ "$1" == "set" ]] || {
    echo "Usage: wallpaper set <image>"
    exit 1
}

[[ -f "$2" ]] || {
    echo "Wallpaper not found: $2"
    exit 1
}

BIN=swww
command -v awww >/dev/null && BIN=awww

exec "$BIN" img "$2" \
    --transition-type wipe \
    --transition-fps 60
