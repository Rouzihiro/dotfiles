#!/usr/bin/env bash
# ~/.local/bin/wallpaper
#
# Assumes swww-daemon or awww-daemon is already running (you start it
# manually / via exec-once). Just picks whichever client is installed
# and tells it to set the image with a transition.
#
# Usage: wallpaper set /path/to/image.jpg

[[ "$1" == "set" ]] || { echo "usage: wallpaper set <path>" >&2; exit 1; }

if command -v awww >/dev/null 2>&1; then
  BIN=awww
else
  BIN=swww
fi

"$BIN" img "$2" --transition-type wipe --transition-fps 60
