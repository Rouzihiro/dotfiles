alias inv="nvim --cmd 'set eventignore=FileType scrollback=1000000' --cmd 'autocmd! *' +'nnoremap q ZQ<CR>' +'call nvim_open_term(0, {})' +'set nolist' +'autocmd! *' +'$' -c 'normal gg'"
alias ai="ollama serve"
alias p="python3 -m"
alias pc="pre-commit run --all-files"
alias x="chmod +x"
alias ali=fzf-aliases
alias typst-up="cargo install typst-cli --force"
alias sf="search-in-file.py"
alias replace="replace-in-file.py"
alias r="replace-in-file.py"

# Search running processes
alias p="ps aux | grep "
alias topcpu="/bin/ps -eo pcpu,pid,user,args | sort -k 1 -r | head -10"

# Search files in the current folder
alias f="find . | grep "

# To see if a command is aliased, a file, or a built-in command
alias checkcommand="type -t"

alias clean-suck='rm -f st dwm dmenu *.o *.orig'
alias disk='ncdu'
alias df2='duf -hide special'
alias mem2='free -h'
alias mem='sudo ps_mem'
alias df='du -sh * 2>/dev/null | sort -hr'
alias temps='sensors'

alias sctl="sudo systemctl"
alias sctls="systemctl status"
alias sctle="sudo systemctl enable --now"
alias sctld="sudo systemctl disable --now"
alias sctlr="sudo systemctl restart"
alias se="sudoedit"

# File and directory management
alias :q="exit"
alias ls="eza -al --group-directories-first --sort=modified --reverse --no-permissions --no-user --no-filesize --time-style=long-iso --icons"
alias lss='eza --long --oneline --icons --color=always --no-permissions --no-user --no-time --group-directories-first 2>/dev/null'
alias lsp="eza -l --color=always --git --no-filesize --icons=always --no-time --no-user --group-directories-first"
alias lt="eza --tree --level=2 --long --icons --git"
alias tree="eza --tree --level=3 --icons --git"

alias cat='bat'
alias md='mkdir -pv'
alias mv='mv -iv'
alias cp='cp -vr'
alias scrp='sudo rsync -ah --progress'
alias crp='rsync -ah --progress'
alias crpe='rsync -avh --progress --inplace --ignore-errors --partial --timeout=10'

alias rm='rm -rf'

alias ls-fonts='fc-list :spacing=100 -f "%{family[0]}\n" | grep -v -iE "emoji|signwriting" | sort -u'
alias ls-fontsf='fc-list :spacing=100 -f "%{family}: %{style}\n" | grep -v -iE "emoji|signwriting" | sort'

alias tp='trash-put'
#alias tl='trash-list | fzf | xargs -r trash-info'
#alias tr='trash-restore'
#alias te='trash-empty -v && echo "Trash emptied"'

# Navigation
alias cdc="cd && cd .config"
alias cde="cd && cd Projects"
alias cdd="cd && cd Downloads"
alias cdp="cd && cd Pictures"
alias cdw="cd && cd Documents"
alias cdv="cd && cd Videos"
alias cds="cd && cd .local/bin"
alias cdf="cd && cd dotfiles"
alias ..='cd ..'
alias ...='cd ../..'
alias .3='cd ../../..'
alias .4='cd ../../../..'
alias .5='cd ../../../../..'

alias fex='muvm bash'

# Editors
v() {
    nvim-theme "$@"
}

vi() {
    nvim-theme -c "lua require('fzf-lua').files()" "$@"
}

vo() {
    nvim-theme -c "lua require('fzf-lua').oldfiles()" "$@"
}

alias vdiff="nvim -d"
alias svim="sudo -E nvim"

# Git
alias g='git'
alias gaa='git add . -v'
alias gc='git commit -m'
alias gst='git status'
alias gps='git push -v'
alias gpf='git push -v --force'
alias gf='git fetch --all --tags --prune'
alias gpl='git pull'
alias gpr='git pull --rebase'
alias lg='lazygit'
alias lgf='cd ~/dotfiles && lazygit'

# System utilities
alias ko='pkill'
alias h='history | fzf'
alias jour='journalctl -xe'
alias openports='netstat -nape --inet'
alias ports='ss -tuln'
alias myip='curl https://ipinfo.io/ip && echo'
alias startup='clear && systemctl list-unit-files --type=service | grep enabled'

# Miscellaneous
alias class='xprop | grep WM_CLASS'
alias reload-bash='source ~/.bashrc'
alias reload='source "$ZDOTDIR/.zshrc" && echo "Zsh config reloaded ✅"'
alias xx='exit'
alias c='clear'
alias t='tmux'
alias yd='yt-dlp'
alias yda='yt-dlp --external-downloader aria2c --external-downloader-args '\''aria2c:-x10 -s10 -k1M'\'''
alias yd1080="yt-dlp -f 'bv*[height<=1080][ext=mp4]+ba[ext=m4a]/b[height<=1080][ext=mp4]/bv*+ba/b' --embed-thumbnail --embed-metadata"
alias yd720="yt-dlp -f 'bv[ext=mp4][height=720]+ba[ext=m4a]/b[ext=mp4][height<=720]' --embed-thumbnail --embed-metadata"

alias wget1='wget --mirror --convert-links --adjust-extension --page-requisites --no-parent'
alias wget2='wget --tries=5 --retry-connrefused --waitretry=30'
alias curldl='curl -L -C - -O'
alias ac='aria2c'
alias aria='aria2c --check-certificate=false -x 16 -s 16'
