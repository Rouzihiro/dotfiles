#!/bin/bash

# Detect compositor
if hyprctl monitors >/dev/null 2>&1; then
    COMPOSITOR="hyprland"
elif swaymsg -t get_outputs >/dev/null 2>&1; then
    COMPOSITOR="sway"
else
    echo "Neither Hyprland nor Sway detected" >&2
    exit 1
fi

CHOICE=$(printf "1. HDMI Only\n2. Laptop Only\n3. Both Displays" | rofi -dmenu -p "Select:")

apply_sway() {
    case $CHOICE in
        "1. HDMI Only")
            swaymsg output eDP-1 disable
            swaymsg output HDMI-A-1 enable mode 1920x1080@60.000Hz
            ;;
        "2. Laptop Only")
            swaymsg output HDMI-A-1 disable
            swaymsg output eDP-1 enable mode 1920x1080@120.019Hz
            ;;
        "3. Both Displays")
            swaymsg output eDP-1 enable mode 1920x1080@120.019Hz
            swaymsg output HDMI-A-1 enable mode 1920x1080@60.000Hz position 1920,0
            ;;
    esac
}

apply_hyprland() {
    case $CHOICE in
        "1. HDMI Only")
            hyprctl keyword monitor "eDP-1,disable"
            hyprctl keyword monitor "HDMI-A-1,1920x1080@60,0x0,1"
            ;;
        "2. Laptop Only")
            hyprctl keyword monitor "HDMI-A-1,disable"
            hyprctl keyword monitor "eDP-1,1920x1080@120.019,0x0,1"
            ;;
        "3. Both Displays")
            hyprctl keyword monitor "eDP-1,1920x1080@120.019,0x0,1"
            hyprctl keyword monitor "HDMI-A-1,1920x1080@60,1920x0,1"
            ;;
    esac
}

[ -z "$CHOICE" ] && exit 0

if [ "$COMPOSITOR" = "sway" ]; then
    apply_sway
else
    apply_hyprland
fi
